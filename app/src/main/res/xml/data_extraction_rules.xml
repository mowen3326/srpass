<?xml version="1.0" encoding="utf-8"?>
<!--
    Blocks cloud backup and device-to-device transfer of every domain.
    Combined with android:allowBackup="false", this guarantees the encrypted
    vault and its key material never leave the device through backup channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
