# Local signing / SDK config must never be committed.
local.properties
*.keystore
*.jks

# Build output
/build
app/build
.gradle/
.kotlin/

# IntelliJ / Android Studio - IDE-generated and machine specific.
# .idea/.gitignore only covered workspace.xml, so every Android Studio
# sync/tweak (gradle.xml, misc.xml, kotlinc.xml, deviceManager.xml, ...) kept
# showing up as an uncommitted change.
.idea/
*.iml
*.ipr
*.iws
captures/
.externalNativeBuild/
.cxx/
.navigation/

# Regenerated by Android Studio's updateDaemonJvm task. It pins a JetBrains
# JDK 25 toolchain, which makes Gradle try to download that JDK from
# api.foojay.io - unreachable on this network (same reason the Gradle
# distribution had to be switched to a CN mirror).
gradle/gradle-daemon-jvm.properties

# Build artifacts
*.apk
*.aab
*.ap_
output-metadata.json

# Logs and OS junk
*.log
.DS_Store
Thumbs.db

# 图标设计源文件（APK 图标在 app/src/main/res/mipmap 下，此目录不入库）
logo/
